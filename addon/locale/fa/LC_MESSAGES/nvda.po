#: addon\appModules\unigram.py:55
msgid "Edit message"
msgstr "پیام را ویرایش کن."

#: addon\appModules\unigram.py:59
msgid "Reply to message"
msgstr "پاسخ بده به پیام."

#. Функція прискорення голосового повідомлення
#: addon\appModules\unigram.py:155
msgid "Increase/decrease the playback speed of voice messages"
msgstr "افزایش/کاهش سرعت پیام صوتی."

#: addon\appModules\unigram.py:163 addon\appModules\unigram.py:175
#: addon\appModules\unigram.py:185 addon\appModules\unigram.py:1064
msgid "Nothing is playing right now"
msgstr "چیزی درحال پخش شدن نیست."

#. Функція закриття аудіопрогравача
#: addon\appModules\unigram.py:166
msgid "Close audio player"
msgstr "بستن پخش کننده ی صدا."

#: addon\appModules\unigram.py:174
msgid "The audio player has been closed"
msgstr "پخش کننده ی صدا بسته شد."

#. Функція призупинення голосового повідомлення
#: addon\appModules\unigram.py:178
msgid "Play/pause the voice message currently playing"
msgstr "پخش / توقف پیام صوتی که در حال حاضر در حال پخش شدن است."

#. Перейти до списку чатів
#: addon\appModules\unigram.py:213
msgid "Move focus to chat list"
msgstr "قرار دادن مکان نما بر روی لیست گفت و گوها."

#: addon\appModules\unigram.py:229
msgid "Chat list not found"
msgstr "لیست گفت و گوها یافت نشد."

#: addon\appModules\unigram.py:237
msgid "Chat list is empty"
msgstr "لیست گفت و گوها خالی است."

#. Перейти до останнього повідомлення в чаті
#: addon\appModules\unigram.py:240
msgid "Move focus to the last message in an open chat"
msgstr "بردن مکاننما به روی آخرین پیام در گفت و گو."

#: addon\appModules\unigram.py:252 addon\appModules\unigram.py:323
#: addon\appModules\unigram.py:733 addon\appModules\unigram.py:746
msgid "This chat is empty"
msgstr "این گفت و گو خالی است."

#: addon\appModules\unigram.py:253 addon\appModules\unigram.py:314
#: addon\appModules\unigram.py:322 addon\appModules\unigram.py:539
#: addon\appModules\unigram.py:729
msgid "No open chat"
msgstr "پنجره گفتوگو باز نیست."

#. Перенести фокус до списку папок чатів
#: addon\appModules\unigram.py:256
msgid "Move focus to list of chat folders"
msgstr "قرار دادن مکان نما بر روی لیست پوشه‌های گفتوگوها."

#: addon\appModules\unigram.py:262 addon\appModules\unigram.py:270
#: addon\appModules\unigram.py:271
msgid "Chat folder list not found"
msgstr "لیست پوشه‌های گفتوگوها یافت نشد."

#. Перенести фокус до відкритого профілю
#: addon\appModules\unigram.py:274
msgid "Move focus to open profile"
msgstr "قرار دادن مکان نما بر روی پنجره ی پروفایل باز شده"

#: addon\appModules\unigram.py:281
msgid "There is no open profile"
msgstr "پنجره ی پروفایل بازی وجود ندارد"

#. Озвучує назву і статус профілю, в відкритому чаті
#: addon\appModules\unigram.py:298
msgid "Announce the name and status of an open chat"
msgstr "نام و وضعیت گفتوگوی باز شده را بگو"

#. Перейти до мітки "непрочитані повідомлення"
#: addon\appModules\unigram.py:317
msgid "Move focus to 'unread messages' label"
msgstr "بردن مکان نما به برچسب پیامهای خوانده نشده."

#: addon\appModules\unigram.py:332
msgid "There are no unread messages in this chat"
msgstr "در این گفت و گو پیام خوانده نشده ای وجود ندارد."

#. Зателефонувати якщо це контакт, або увійти до голосового чату, якщо це група
#: addon\appModules\unigram.py:335
msgid "Call if it's a contact, or enter a voice chat if it's a group"
msgstr ""
"تماس گرفتن اگر این مخاطب باشد یا ورود کن به گفت و گوی صوتی اگر این یک گروه "
"باشد."

#: addon\appModules\unigram.py:340
msgid "Call unavailable"
msgstr "دکمه ی تماس در دسترس نیست."

#. Зателефонувати по відеозв'язку якщо це контакт
#: addon\appModules\unigram.py:343
msgid "Press the video call button"
msgstr "فشار دادن دکمه تماس تصویری."

#: addon\appModules\unigram.py:347
msgid "Video call not available"
msgstr "تماس تصویری در دسترس نیست."

#. Функція відкриття миттєвого перегляду статті
#: addon\appModules\unigram.py:350
msgid "Press \"Instant view\" button, if it is included in the current message"
msgstr "فشار دادن دکمه ی مشاهده ی سریع اگر در این پیام موجود باشد."

#: addon\appModules\unigram.py:361 addon\appModules\unigram.py:496
#: addon\appModules\unigram.py:503 addon\appModules\unigram.py:511
msgid "Button not found"
msgstr "دکمه ای یافت نشد."

#. Відповідь на дзвінок
#: addon\appModules\unigram.py:364
msgid "Accept call"
msgstr "پاسخ دادن به تماس."

#. Завершити дзвінок, відхилити дзвінок, або покинути голосовий чат
#: addon\appModules\unigram.py:373
msgid ""
"Press \"Decline call\" button  if there is an incoming call, \"End call\" "
"button if a call is in progress or leave voice chat if it is active."
msgstr ""
"فشار بده دکمه ی رد تماس را اگر تماس ورودی وجود داشت پایان دادن به تماس را اگر "
"در حال برقراری تماسی بود یا فشار بده دکمه ی ترک کردن گفت و گوی صوتی را اگر "
"فعال بود."

#. Вимкнення/увімкнення мікрофону
#: addon\appModules\unigram.py:387
msgid "Press \"Mute/unmute microphone\" button"
msgstr "فشار بده دکمه ی فعال/غیر فعال کردن میکروفون را."

#. Вимкнення/увімкнення камери
#: addon\appModules\unigram.py:413
msgid "Press \"Enable/disable camera\" button"
msgstr "دکمه ی \"فعال/غیر فعال کردن دوربین\" را فشار بده."

#. Скопіювати поточне повідомлення в буфер обміну
#: addon\appModules\unigram.py:441
msgid ""
"Copy the message if it contains text. If the focus is on a link, the link "
"will be copied"
msgstr ""
"اگر در پیام متن وجود دارد, پیام را کپی کن. اگر مکاننما روی لینک قرار دارد, آن "
"لینک کپی خواهد شد."

#: addon\appModules\unigram.py:447
msgid "Message copied"
msgstr "پیام کپی شد"

#: addon\appModules\unigram.py:450
msgid "Link copied"
msgstr "لینک کپی شد."

#: addon\appModules\unigram.py:455 addon\appModules\unigram.py:469
msgid "This message does not contain text"
msgstr "این پیام دارای متن نیست."

#. Скопіювати повідомлення через контекстне меню
#: addon\appModules\unigram.py:458
msgid "Copy messages with formatting preserved"
msgstr "پیام را همراه با قالببندی آن کپی کن."

#. Показати текст повідомлення в спливаючому вікні
#: addon\appModules\unigram.py:463
msgid "Show message text in popup window"
msgstr "متن پیام را در پنجره نمایش بده."

#: addon\appModules\unigram.py:468
msgid "message text"
msgstr "پیام پاک شد"

#. Перенести фокус в поле вводу повідомлення. Якщо фокус вже знаходиться в цьому полі, тоді перенести його на останній елемент який був в фокусі перед цим полем
#: addon\appModules\unigram.py:472
msgid ""
"Move the focus to the edit field. If the focus is already in the edit field, "
"then after pressing the hotkey, it will move to where it was before"
msgstr ""
"بردن مکان نما به کادر ویرایش. اگر مکان نما بر روی کادر ویرایش باشد با فشار "
"دادن کلیدهای میانبر مکان نما به همان جایی که بود برمیگردد."

#: addon\appModules\unigram.py:489
msgid "Message input field not found"
msgstr "کادر ویرایش مخصوص پیام یافت نشد."

#. Натиснути кнопку "Вкласти медіа"
#: addon\appModules\unigram.py:492
msgid "Press \"Attach file\" button"
msgstr "فشار دادن دکمه \"ضمیمه کردن رسانه\""

#. Натиснути кнопку "Нова розмова"
#: addon\appModules\unigram.py:499
#, fuzzy
#| msgid "Press \"New chat\" button"
msgid "Press \"New conversation\" button"
msgstr "فشار دادن دکمه \"گفتگوی جدید \""

#. Відкриває меню навігації
#: addon\appModules\unigram.py:514
msgid "Open navigation menu"
msgstr "باز کردن فهرست مسیریابی."

#: addon\appModules\unigram.py:519
msgid "Navigation menu not available"
msgstr "فهرست مسیریابی در دسترس نیست."

#. Функція відкриття коментарів
#: addon\appModules\unigram.py:522
msgid "Open comments"
msgstr "باز کردن بخش نظرات."

#: addon\appModules\unigram.py:530
msgid "Button to open comments not found"
msgstr "دکمه ی نظرات یافت نشد."

#. Функція відкриття профілю поточного чату
#: addon\appModules\unigram.py:533
msgid "Open current chat profile"
msgstr "باز کن پروفایل گفتوگویی را که باز است."

#: addon\appModules\unigram.py:555
msgid ""
"It will not be possible to record a voice message until the edit field is "
"empty"
msgstr "ضبط پیام صوتی ممکن نیست تا وقتی که کادر ویرایش خالی شود."

#: addon\appModules\unigram.py:562
msgid "Record sent"
msgstr "پیام صوتی ارسال شد."

#: addon\appModules\unigram.py:567
msgid "Video"
msgstr "تصویر"

#: addon\appModules\unigram.py:568
msgid "Audio"
msgstr "صوت"

#: addon\appModules\unigram.py:585
msgid "Voice recording notifications set to text"
msgstr "اعلانهای ضبط پیام صوتی به حالت متن تغییر کرد."

#: addon\appModules\unigram.py:588
msgid "Voice recording notifications set to sounds"
msgstr "اعلانهای ضبط پیام صوتی به حالت صدا تغییر کرد."

#: addon\appModules\unigram.py:591
msgid "Recording voice messages has standard behavior"
msgstr "اعلانهای ضبط پیام صوتی حالت استاندارد دارند."

#: addon\appModules\unigram.py:601
msgid "Reply canceled"
msgstr "پاسخ دادن لغو شد"

#: addon\appModules\unigram.py:602
msgid "Edit canceled"
msgstr "ویرایش لغو شد"

#: addon\appModules\unigram.py:605
msgid "Recording canceled"
msgstr "ضبط پیام صوتی لغو شد."

#: addon\appModules\unigram.py:635
msgid "Answer options"
msgstr "گزینه‌های جواب."

#: addon\appModules\unigram.py:665
msgid "You"
msgstr "شما"

#. Провіряємо стан повідомлення, чи є воно прочитаним і надісланим
#: addon\appModules\unigram.py:669
msgid "Not sent"
msgstr "ارسال نشده"

#. Озвучуємо реакції, якщо вони містяться в повідомленні
#: addon\appModules\unigram.py:683
msgid "Reactions"
msgstr "واکنشها"

#. Перевіряємо чи повідомлення є виділеним
#: addon\appModules\unigram.py:689
msgid "Selected"
msgstr "انتخاب شده."

#: addon\appModules\unigram.py:709
msgid "there are replies for you"
msgstr "پاسخهایی برای شما موجود است."

#. Змінити рівень озвучення індикаторів виконання
#: addon\appModules\unigram.py:714
msgid "Toggle progress bar announcements"
msgstr "جا به جا کردن گفته شدن نوار پیشرفت."

#: addon\appModules\unigram.py:718
#: addon\GlobalPlugins\UnigramAccess\__init__.py:143
msgid "Announce all progress bars"
msgstr "گفته شدن همه ی نوارهای پیشرفت."

#: addon\appModules\unigram.py:721
#: addon\GlobalPlugins\UnigramAccess\__init__.py:144
msgid "Do not announce any progress bars"
msgstr "هیچ نوار پیشرفتی گفته نشود."

#: addon\appModules\unigram.py:822
msgid "Editing"
msgstr "در حال ویرایش"

#: addon\appModules\unigram.py:823
msgid "Reply"
msgstr "پاسخ"

#: addon\appModules\unigram.py:832
msgid "Duration"
msgstr "زمان"

#: addon\appModules\unigram.py:833
msgid "Size"
msgstr "حجم"

#: addon\appModules\unigram.py:845
msgid "Enable video"
msgstr "فعال کردن تصویر"

#: addon\appModules\unigram.py:846
msgid "Disable video"
msgstr "غیر فعال کردن تصویر"

#: addon\appModules\unigram.py:924
msgid "Delete a message or chat"
msgstr "پاک کردن پیام یا گفتوگو."

#: addon\appModules\unigram.py:927
msgid "Delete message or chat from both sides"
msgstr "پاک کردن پیام یا گفتوگو برای دو طرف."

#: addon\appModules\unigram.py:945
msgid "Inline results not found"
msgstr "نتایج دستور یافت نشد."

#: addon\appModules\unigram.py:956
msgid "Inline results not detected"
msgstr "نتایج دستور یافت نشد."

#: addon\appModules\unigram.py:959
msgid "Switch to selection mode"
msgstr "حالت را به حالت انتخاب تغییر بده."

#: addon\appModules\unigram.py:962
msgid "Forward message"
msgstr "پیام را هدایت کن."

#: addon\appModules\unigram.py:965
msgid "Mark a chat as read"
msgstr "مارک کن گفتوگو را به حالت خوانده شده."

#: addon\appModules\unigram.py:968
msgid "Save file as..."
msgstr "زخیره ی فایل به عنوان"

#: addon\appModules\unigram.py:971
msgid "Pin a message or chat"
msgstr "سنجاق کردن پیام یا گفتوگو."

#: addon\appModules\unigram.py:997
msgid "Message deleted on both sides"
msgstr "پیام برای دو طرف پاک شد."

#: addon\appModules\unigram.py:998
